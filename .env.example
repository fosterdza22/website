# Copy to Railway Dashboard -> Variables. These are read by config/db.php and config/paystack.php

# TiDB Cloud database (from https://tidbcloud.com -> your cluster -> Connect)
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=hostel_agency
DB_USER=2rCWfbneuxXyXZn.root
DB_PASS=your_tidb_password_here
DB_SSL=1

# Paystack (Settings -> API Keys & Webhooks). Use TEST keys until you go live.
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx